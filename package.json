{
  "name": "resalti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "رسـالتي | Resalti ❤️ — لما يعجز الكلام، خلّي رسالتي تتكلم.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "npm run build && cross-env NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.*"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "jsdom": "^30.1.1",
    "vite": "^6.4.3"
  }
}
