{
  "name": "StudentOS",
  "short_name": "StudentOS",
  "description": "منصة تعليمية ذكية لطلاب وأساتذة التعليم الثانوي في الجزائر - خطط. ادرس. ركّز. تذكّر. تطوّر.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0f172a",
  "background_color": "#0b1120",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
