      "url": "/?tab=focus-study",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "المساعد الذكي (AI Tutor)",
      "short_name": "AI Tutor",
      "description": "طرح الأسئلة وحل تمارين المنهاج الثانوي الجزائري",
      "url": "/?tab=ai-tutor",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "خريطة المعرفة (Knowledge Map)",
