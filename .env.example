# ── رسـالتي | Resalti — server-side configuration ──────────────────────────
# Copy to .env and fill in. NEVER put these values in the frontend: they are
# read only by server/index.js and are never sent to the browser.

# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, OpenRouter,
# a local Ollama/vLLM server, …). Leave the key empty to run the built-in
# offline engine — the app is fully functional without it.
RESALTI_API_KEY=
RESALTI_BASE_URL=https://api.openai.com/v1
RESALTI_MODEL=gpt-4o-mini

# OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL are also accepted.

PORT=4000
HOST=0.0.0.0
