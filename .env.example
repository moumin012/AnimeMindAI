# Public Firebase Web configuration. These are identifiers, not secrets.
# Set all fields to enable Firebase Authentication.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional same-origin API for AI. The browser never receives an LLM provider key.
# Example: https://api.studentos.example/v1
REACT_APP_API_BASE_URL=
